# ============================================================
# Copy this file to .env and fill in all values before running.
# Never commit .env to version control.
# ============================================================

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# must match exactly what is set in the discord oauth2 redirect URIs
DISCORD_REDIRECT_URI=https://panel.852r.org/auth/callback

# permission maps
DISCORD_ROLE_ADMIN=
DISCORD_ROLE_MOD=
DISCORD_ROLE_TRIAL=

# channel id
DISCORD_MOD_LOG_CHANNEL=
DISCORD_LEVELUP_CHANNEL=       # arcane level-up announcements
DISCORD_INTRO_CHANNEL=         # introductions channel (160 char minimum)
DISCORD_VENT_APPROVAL_CHANNEL= # staff approval channel for anonymous vents
DISCORD_VENT_POSTS_CHANNEL=    # public channel where approved vents are posted

# arcane level parsing
ARCANE_LEVELUP_REGEX=Congrats .+, you have (\d+) YUU Points!

# RANK_*_ROLE_ID: the discord role ID for each rank
# RANK_*_MIN / MAX: arcane level thresholds for levelled ranks
#   Leave min/max blank for manually assigned ranks

# role id
RANK_STAFF_ROLE_ID=
RANK_LUMINARY_ROLE_ID=
RANK_PRESTIGE_ROLE_ID=
RANK_VICE_ROLE_ID=
RANK_SENATOR_ROLE_ID=
RANK_DIGNITARY_ROLE_ID=
RANK_ATTACHE_ROLE_ID=
RANK_CITIZEN_ROLE_ID=
# levels
RANK_CITIZEN_MIN=
RANK_CITIZEN_MAX=
RANK_ATTACHE_MIN=
RANK_ATTACHE_MAX=
RANK_DIGNITARY_MIN=
RANK_DIGNITARY_MAX=
RANK_SENATOR_MIN=
RANK_SENATOR_MAX=
RANK_VICE_MIN=

# rank colours for injection
VITE_COLOR_STAFF=#f4a9ff
VITE_COLOR_LUMINARY=#8fc7c8
VITE_COLOR_PRESTIGE=#ffd700
VITE_COLOR_VICE=#eb22ff
VITE_COLOR_SENATOR=#009e60
VITE_COLOR_DIGNITARY=#fe0000
VITE_COLOR_ATTACHE=#ff02a3
VITE_COLOR_CITIZEN=#ff8a00

# GOOGLE_SA_KEY_PATH should point to the mounted secrets file
GOOGLE_SA_KEY_PATH=/app/secrets/gsa-key.json
SHEETS_WARNINGS_ID=            # Google Sheets document ID for warnings
SHEETS_MEMBERS_ID=             # Google Sheets document ID for members

# crafty controller
# API key generated in Crafty under Settings > API
CRAFTY_API_URL=http://host.docker.internal:8443/api/v2
CRAFTY_API_KEY=
CRAFTY_SERVER_ID=              # The UUID of the server shown in Crafty's URL

# mediawiki: use bot password
WIKI_API_URL=https://wiki.852r.org/api.php
WIKI_BOT_USERNAME=             # Format: WikiUsername@BotPasswordName
WIKI_BOT_PASSWORD=

# for JWT_SECRET:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY=8h
COOKIE_DOMAIN=.852r.org

# docker
# GHCR_OWNER: gh username or org name
# IMAGE_TAG: set to a specific SHA or semver in CI; defaults to 'latest'
GHCR_OWNER=
IMAGE_TAG=latest

# VITE_API_BASE_URL: base URL the frontend uses for API calls
# in prod this should be empty string (same-origin via nginx proxy)
# in dev this points directly to the backend: http://localhost:3001
VITE_API_BASE_URL=

# VITE_CRAFTY_URL: web UI URL for the "Open Crafty" link on the console page
VITE_CRAFTY_URL=http://localhost:8443

# actual app
PORT=3001
NODE_ENV=production
LOG_LEVEL=info                 # error | warn | info | debug
